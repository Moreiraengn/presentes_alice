# Copie este arquivo para .env.local e preencha. Escreva os valores SEM aspas.

# Endereço público deste módulo (usado no retorno e nos avisos do Mercado Pago)
# Ex.: https://presentes-gabriel-e-alice.vercel.app  ou  https://presentes.gabrielealice.com.br
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Senha do painel /admin (obrigatória em produção; no computador, sem ela, a senha é "admin")
ADMIN_PASSWORD=

# Banco: no computador usa file:local.db sozinho.
# Produção: crie um banco Turso pela Vercel (Storage → Turso), que cria estas duas sozinha:
# TURSO_DATABASE_URL=libsql://seu-banco.turso.io
# TURSO_AUTH_TOKEN=

# Mercado Pago: mercadopago.com.br/developers → Suas integrações → (sua aplicação) → Credenciais
# Comece com as credenciais de TESTE; para receber de verdade, troque pelas de PRODUÇÃO.
MP_ACCESS_TOKEN=
# Opcional: Webhooks → Configurar notificações → "Assinatura secreta"
MP_WEBHOOK_SECRET=
